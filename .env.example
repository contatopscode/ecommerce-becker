# ============================================
# Becker E-commerce - Environment Variables
# ============================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env no git (já está no .gitignore).

# ============ BANCO DE DADOS ============
# Conexão externa (de fora da VPS)
DATABASE_URL="postgresql://postgres:SUA_SENHA@HOST_EXTERNO:5432/banco2026?sslmode=disable"
# Conexão interna (dentro da VPS, via Docker network)
DATABASE_URL_INTERNAL="postgresql://postgres:SUA_SENHA@bancos2026_postgres:5432/banco2026?sslmode=disable"

# ============ AUTENTICAÇÃO ============
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET="trocar-por-uma-chave-segura-aqui"
NEXTAUTH_URL="https://becker.pscode.ia.br"

# ============ WHATSAPP (EVOLUTION API) ============
EVOLUTION_API_URL="https://evolution-evolution-api.vcli1q.easypanel.host"
EVOLUTION_API_KEY="sua-api-key-aqui"
EVOLUTION_INSTANCE="Vigilia"

# ============ IA (OPENAI) ============
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# ============ PAGAMENTO (MERCADO PAGO) ============
# Credenciais: https://www.mercadopago.com.br/developers/panel/credentials
# IMPORTANTE: configure pelo admin (/admin/configuracoes > Pagamentos)
# Estas env vars são fallback caso o admin não tenha configurado ainda
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MERCADOPAGO_PUBLIC_KEY="APP_USR-..."
MERCADOPAGO_SANDBOX="true"  # true=teste, false=produção

# URL do webhook MP (opcional, default: SITE_DOMAIN + /api/webhooks/mercadopago)
MERCADOPAGO_WEBHOOK_URL=""

# ============ SITE ============
SITE_DOMAIN="https://becker.pscode.ia.br"
NODE_ENV="development"

# ============ BACKUP AUTOMÁTICO ============
# Token para proteger a API de backup (gere com: openssl rand -base64 32)
BACKUP_TOKEN="seu-token-seguro-aqui-com-32-chars-min"
# Diretório de backup (padrão: ./backups)
BACKUP_DIR="/app/backups"
# Retenção em dias (padrão: 7)
BACKUP_RETENTION_DAYS="7"

# ============ LGPD / ANALYTICS (opcional) ============
# Google Analytics 4 (só carrega com consentimento)
NEXT_PUBLIC_GA4_ID=""
# Facebook Pixel (só carrega com consentimento)
NEXT_PUBLIC_FB_PIXEL_ID=""
