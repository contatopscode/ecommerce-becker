// ============================================================
// Becker E-commerce - Prisma Schema
// Banco: PostgreSQL 17 (VPS)
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USERS ============
model User {
  id           String    @id @default(cuid())
  name         String
  whatsapp     String    @unique
  email        String?   @unique
  cpfCnpj      String?   @unique
  passwordHash String?
  role         Role      @default(CUSTOMER)

  // 2FA (TOTP)
  twoFactorEnabled   Boolean   @default(false)
  twoFactorSecret    String?   // Base32 encoded TOTP secret
  twoFactorBackupCodes String?  // JSON array de códigos hasheados

  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([whatsapp])
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

// ============ CATEGORIES ============
model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?
  color       String?
  order       Int       @default(0)
  products    Product[]
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============ PRODUCTS ============
model Product {
  id              String           @id @default(cuid())
  slug            String           @unique
  sku             String           @unique
  name            String
  description     String           @db.Text
  shortDescription String?
  brand           String           @default("Becker")
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  isEco           Boolean          @default(false)
  isFeatured      Boolean          @default(false)
  isTop           Boolean          @default(false)
  isNew           Boolean          @default(false)
  active          Boolean          @default(true)
  rating          Float            @default(0)
  reviewCount     Int              @default(0)
  highlights      String[]
  images          ProductImage[]
  versions        ProductVersion[]
  reviews         Review[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([isTop])
  @@index([isFeatured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

model ProductVersion {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String   @unique
  label         String   // ex: "500ml Lavanda", "3L"
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  stock         Int      @default(0)
  weight        Int?     // gramas
  height        Int?     // mm
  width         Int?     // mm
  length        Int?     // mm
  barcode       String?
  active        Boolean  @default(true)

  @@index([productId])
}

// ============ ADDRESSES ============
model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cep        String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  isDefault  Boolean @default(false)
  orders     Order[]
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ============ ORDERS ============
model Order {
  id             String         @id @default(cuid())
  number         String         @unique // BKR-202608-000123
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  guestEmail     String?
  guestWhatsapp  String?

  items          OrderItem[]
  addressId      String?
  address        Address?       @relation(fields: [addressId], references: [id])

  subtotal       Decimal        @db.Decimal(10, 2)
  shipping       Decimal        @db.Decimal(10, 2)
  discount       Decimal        @default(0) @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)

  status         OrderStatus    @default(PENDING)
  paymentStatus  PaymentStatus  @default(PENDING)
  source         OrderSource    @default(SITE)

  paymentId      String?        // ID do Mercado Pago
  paymentMethod  PaymentMethod?
  tracking       String?
  shippingMethod ShippingMethod? @default(free)

  notes          String?
  paidAt         DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([number])
  @@index([status])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING       // Aguardando pagamento
  PAID          // Pago
  PROCESSING    // Em separação
  SHIPPED       // Enviado
  DELIVERED     // Entregue
  CANCELLED     // Cancelado
  REFUNDED      // Reembolsado
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderSource {
  SITE
  WHATSAPP
  ADMIN
}

enum PaymentMethod {
  pix
  credit_card
  boleto
}

enum ShippingMethod {
  free
  pac
  sedex
}


model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  productName  String  // snapshot
  versionId    String
  versionLabel String  // snapshot
  sku          String
  price        Decimal @db.Decimal(10, 2)
  qty          Int
  total        Decimal @db.Decimal(10, 2)

  // SPRINT 11: Se esse item é um kit, referencia o Kit vendido
  // (null = produto unitário, setado = kit)
  kitId        String?
  // Snapshot dos itens do kit no momento da venda
  // (preço/nome podem mudar no futuro; o pedido mantém o histórico)
  kitItems     OrderItemKitItem[]

  @@index([orderId])
  @@index([kitId])
}

model OrderItemKitItem {
  id           String  @id @default(cuid())
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productId    String
  productName  String
  versionId    String?
  versionLabel String?
  qty          Int
  unitPrice    Decimal  @db.Decimal(10, 2)  // preço unitário do item no momento

  @@index([orderItemId])
}

// ============ COUPONS ============
model Coupon {
  id        String       @id @default(cuid())
  code      String       @unique
  type      String       // percent, fixed, shipping
  discount  Float        // % ou R$
  minOrder  Float        @default(0)
  maxUses   Int?
  usedCount Int          @default(0)
  expiresAt DateTime?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

// ============ REVIEWS ============
model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int      // 1-5
  title     String?
  comment   String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId])
}

// ============ WHATSAPP CONVERSATIONS ============
model WhatsAppConversation {
  id            String    @id @default(cuid())
  phone         String
  customerName  String?
  messages      Json      // array de mensagens
  context       Json?     // estado do bot (qual fluxo está)
  resolved      Boolean   @default(false)
  humanTakeover Boolean   @default(false)
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([phone])
  @@index([lastMessageAt])
}

// ============ NEWSLETTER ============
model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============ CART RECOVERY (Sprint 9) ============
// Carrinhos salvos pelo cliente durante o checkout
// Se não virar pedido em X horas, dispara WhatsApp automático
model CartRecovery {
  id              String   @id @default(cuid())
  whatsapp        String   // cliente
  customerName    String?
  items           Json     // [{ productId, name, versionId, versionLabel, price, qty, image }]
  subtotal        Decimal  @db.Decimal(10, 2)
  totalItems      Int      // qtd total de itens
  cupom           String?  // cupom aplicado (se houver)

  // Tracking de mensagens enviadas
  sent1h          Boolean  @default(false)  // msg 1 hora enviada?
  sent1hAt        DateTime?
  sent24h         Boolean  @default(false)
  sent24hAt       DateTime?
  sent72h         Boolean  @default(false)
  sent72hAt       DateTime?

  // Status
  converted       Boolean  @default(false)  // virou pedido?
  orderId         String?  // pedido gerado
  expiresAt       DateTime // 7 dias (limpeza automática)
  lastSeenAt      DateTime @default(now())  // última vez que frontend salvou

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([whatsapp])
  @@index([expiresAt])
  @@index([converted])
  @@index([lastSeenAt])
}

// ============ KITS (Sprint 11) ============
// Bundles pré-montados de produtos Becker com desconto
// Ex: "Kit Limpeza Básica" = Limpador Multiuso + Desinfetante
// O cliente compra 1 produto (o kit) e recebe todos os itens
model Kit {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String     @db.Text
  shortDescription String?
  image       String?    // URL da imagem do kit (montada)
  category    String?    // "limpeza", "cozinha", "banheiro", "lavanderia", "casa"
  // Preço
  price       Decimal    @db.Decimal(10, 2)  // preço promocional do kit
  originalPrice Decimal  @db.Decimal(10, 2)  // soma dos itens sem desconto
  discountPercent Int    @default(0)
  // Metadata
  isActive    Boolean    @default(true)
  isFeatured  Boolean    @default(false)
  order       Int        @default(0)
  // Itens do kit
  items       KitItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive])
  @@index([isFeatured])
  @@index([category])
}

model KitItem {
  id          String  @id @default(cuid())
  kitId       String
  kit         Kit     @relation(fields: [kitId], references: [id], onDelete: Cascade)
  productId   String
  // Snapshot do produto no momento da venda
  productName String
  versionId   String?
  versionLabel String?
  qty         Int     @default(1)

  @@index([kitId])
  @@index([productId])
}

// ============ SETTINGS ============
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  label     String?
  type      String   @default("text")  // text, number, boolean, json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
